{
  "name": "fetris-be",
  "version": "0.1.0",
  "private": true,
  "description": "Fetris 1대1 대전 WebSocket 릴레이 서버",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "bot:example": "node examples/bot-runner.mjs",
    "bot:token": "node scripts/bot-token.mjs"
  },
  "dependencies": {
    "@fetris/engine": "*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
